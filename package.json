{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:5174": "vite --port 5174",
    "prebuild": "if [ -f scripts/generate-version-file.sh ]; then chmod +x scripts/generate-version-file.sh && ./scripts/generate-version-file.sh || echo '⚠️ Script de versão não encontrado, continuando...'; else echo '⚠️ Script de versão não encontrado, criando versão básica...' && mkdir -p public && echo '{\"version\":\"0.0.0\",\"timestamp\":\"'$(date -u +%Y-%m-%dT%H:%M:%SZ)'\",\"changes\":\"Versão automática\"}' > public/version.json; fi",
    "build": "vite build",
    "build:extension": "npm install --no-audit --no-fund --prefix extensions/agilize-crm-sidekick && npm run build --prefix extensions/agilize-crm-sidekick",
    "package:extension": "chmod +x scripts/package-chrome-extension.sh && ./scripts/package-chrome-extension.sh",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check-imports": "./scripts/validar-imports.sh src",
    "type-check": "tsc --noEmit",
    "validate": "./scripts/validar-codigo-completo.sh",
    "validate:quick": "./scripts/validar-codigo-completo.sh --skip-tests",
    "health-check": "./scripts/health-check-completo.sh",
    "health-check:fix": "./scripts/health-check-completo.sh --fix",
    "regression": "npm run lint && npm run build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install",
    "test:oscilacao:iclass": "python3 scripts/teste-oscilacao-status-evolution.py --org 34086d07-9181-43fc-a3e8-6aa28974d68b",
    "report:servidor-vs-campanha:iclass": "python3 scripts/relatorio-servidor-vs-campanha-iclass.py --org 34086d07-9181-43fc-a3e8-6aa28974d68b",
    "report:quedas-iclass:chart": "python3 scripts/relatorio-quedas-iclass-chart.py",
    "test:validacao:rotacao": "node scripts/teste-rotacao-validacao-broadcast.mjs",
    "test:validacao:iclass": "python3 scripts/teste-validacao-disparador2-evolution.py --org 34086d07-9181-43fc-a3e8-6aa28974d68b --open-limit 3 --delay 1.2",
    "test:validacao:disparador2": "npm run test:validacao:rotacao && npm run test:validacao:iclass",
    "test:validacao:edge-iclass": "python3 scripts/teste-validacao-edge-iclass.py",
    "test:validacao:completa": "npm run test:validacao:rotacao && npm run test:validacao:iclass && npm run test:validacao:edge-iclass",
    "test:agenda": "node scripts/teste-agenda-timezone.mjs",
    "test:agenda:edge": "python3 scripts/teste-agenda-edge-smoke.py",
    "test:agenda:completa": "chmod +x scripts/teste-agenda-completo.sh && ./scripts/teste-agenda-completo.sh",
    "test:validacao:iclass:json": "python3 scripts/teste-validacao-disparador2-evolution.py --org 34086d07-9181-43fc-a3e8-6aa28974d68b --open-limit 3 --delay 1.2 --json",
    "test:e2e:auto": "./scripts/teste-automatico-completo.sh",
    "test:e2e:analyze": "./scripts/teste-automatico-completo.sh --report-only",
    "test:e2e:fix": "./scripts/teste-automatico-completo.sh auto --fix",
    "test:e2e:codegen": "playwright codegen http://localhost:8080",
    "test:e2e:wordpress-api": "playwright test tests/e2e/wordpress-ai-auth.spec.ts --project=chromium",
    "test:e2e:funnel-tags": "playwright test tests/e2e/funnel-lead-tags.spec.ts tests/e2e/lead-tags-sync.unit.spec.ts --config=playwright.deployed.config.ts --project=chromium-functional",
    "test:e2e:funnel-perf": "playwright test tests/e2e/funnel-tab-switch.perf.spec.ts tests/e2e/funnel-perf-diagnosis.unit.spec.ts --project=chromium",
    "test:e2e:funnel-perf:deployed": "playwright test tests/e2e/funnel-tab-switch.perf.spec.ts tests/e2e/funnel-perf-diagnosis.unit.spec.ts --config=playwright.deployed.config.ts",
    "test:e2e:funnel-perf:secure": "playwright test tests/e2e/funnel-tab-switch.perf.spec.ts tests/e2e/funnel-perf-diagnosis.unit.spec.ts --config=playwright.deployed.config.ts",
    "test:e2e:funnel-perf:multirun": "chmod +x scripts/run-funnel-perf-multirun.sh && ./scripts/run-funnel-perf-multirun.sh",
    "test:funnel-perf-gate": "chmod +x scripts/run-funnel-perf-gate.sh && ./scripts/run-funnel-perf-gate.sh",
    "test:e2e:funnel-outage": "playwright test tests/e2e/funnel-network-outage.perf.spec.ts --config=playwright.deployed.config.ts",
    "test:e2e:funnel-validation": "playwright test tests/e2e/funnel-diagnosis-validation.perf.spec.ts --config=playwright.deployed.config.ts",
    "test:unit:funnel-validation": "playwright test tests/e2e/funnel-diagnosis-validation.unit.spec.ts --config=playwright.deployed.config.ts --project=chromium-unit",
    "test:funnel-diagnosis:full": "chmod +x scripts/run-funnel-diagnosis-validation.sh && ./scripts/run-funnel-diagnosis-validation.sh",
    "test:e2e:funnel-slow-network": "playwright test tests/e2e/funnel-slow-network.perf.spec.ts --config=playwright.deployed.config.ts",
    "test:e2e:funnel-longtask": "playwright test tests/e2e/funnel-longtask.perf.spec.ts --config=playwright.deployed.config.ts",
    "test:e2e:funnel-render-profile": "playwright test tests/e2e/funnel-render-profile.perf.spec.ts --config=playwright.deployed.config.ts",
    "test:e2e:funnel-column-visibility": "playwright test tests/e2e/funnel-column-visibility.perf.spec.ts --config=playwright.deployed.config.ts",
    "test:e2e:funnel-card-scaling": "playwright test tests/e2e/funnel-card-count-scaling.perf.spec.ts --config=playwright.deployed.config.ts",
    "test:e2e:funnel-first-load-breakdown": "playwright test tests/e2e/funnel-first-load-breakdown.perf.spec.ts --config=playwright.deployed.config.ts",
    "test:funnel-baseline:high-volume": "chmod +x scripts/run-funnel-baseline-high-volume.sh && ./scripts/run-funnel-baseline-high-volume.sh",
    "test:seed-e2e-funnel": "node scripts/seed-e2e-funnel-leads.mjs",
    "test:funnel-diagnosis:extended": "chmod +x scripts/run-funnel-diagnosis-extended.sh && ./scripts/run-funnel-diagnosis-extended.sh",
    "test:validate-funnel": "npm run test:unit:lead-tags && npm run test:unit:funnel-perf && npm run test:e2e:funnel-perf:secure",
    "test:unit:funnel-perf": "playwright test tests/e2e/funnel-perf-diagnosis.unit.spec.ts --project=chromium",
    "test:unit:lead-tags": "playwright test tests/e2e/lead-tags-sync.unit.spec.ts --project=chromium",
    "test:e2e:human": "playwright test --grep @human-behavior",
    "test:e2e:accessibility": "playwright test --grep @accessibility",
    "test:e2e:performance": "playwright test --grep @performance",
    "test:e2e:visual": "playwright test --grep @visual",
    "test:new-feature": "./scripts/testar-nova-funcionalidade.sh",
    "security:audit": "npm audit",
    "security:audit:fix": "npm audit fix",
    "prepare": "husky install || true"
  },
