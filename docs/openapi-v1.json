{
  "openapi": "3.0.3",
  "info": {
    "title": "Agilize CRM Public API",
    "version": "2.0.0",
    "description": "API pública org-scoped. Documentação ≠ acesso: toda chamada exige Authorization: Bearer agz_live_... da organização. Ver também /docs/api no site.",
    "x-changelog": [
      {
        "version": "1.0.0",
        "notes": "Leads CRUD, stages/tags read"
      },
      {
        "version": "1.1.0",
        "notes": "Tags write, activities, products, budgets, OS, members, broadcasts read"
      },
      {
        "version": "1.2.0",
        "notes": "Finance, POS read, Asaas wrap"
      },
      {
        "version": "2.0.0",
        "notes": "Bookings, calendar events, outbound webhooks (HMAC X-Agilize-Signature)"
      }
    ]
  },
  "servers": [
    {
      "url": "{supabaseUrl}/functions/v1/api-v1",
      "variables": {
        "supabaseUrl": {
          "default": "https://YOUR_PROJECT.supabase.co"
        }
      }
    }
  ],
  "security": [
    {
      "ApiKeyBearer": []
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "agz_live",
        "description": "API key gerada em Configurações → API"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Lead": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "organization_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "company": {
            "type": "string",
            "nullable": true
          },
          "value": {
            "type": "number",
            "nullable": true
          },
          "stage_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "status": {
            "type": "string",
            "nullable": true
          },
          "source": {
            "type": "string",
            "nullable": true
          },
          "notes": {
            "type": "string",
            "nullable": true
          },
          "assigned_to": {
            "type": "string",
            "nullable": true
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          }
        }
      },
      "LeadCreate": {
        "type": "object",
        "required": [
          "name",
          "phone"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "company": {
            "type": "string",
            "nullable": true
          },
          "value": {
            "type": "number",
            "nullable": true
          },
          "stage_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "notes": {
            "type": "string",
            "nullable": true
          },
          "source": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "price": {
            "type": "number"
          },
          "category": {
            "type": "string",
            "nullable": true
          },
          "is_active": {
            "type": "boolean"
          },
          "sale_paused": {
            "type": "boolean"
          },
          "commission_percentage": {
            "type": "number",
            "nullable": true
          },
          "commission_fixed": {
            "type": "number",
            "nullable": true
          }
        }
      },
      "Budget": {
        "type": "object"
      },
      "ServiceOrder": {
        "type": "object"
      },
      "FinancialEntry": {
        "type": "object"
      },
      "Webhook": {
        "type": "object"
      }
    }
  },
