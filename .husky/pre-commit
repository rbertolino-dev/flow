#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Pre-commit hook para validar código antes de commit
# 
# Executa:
# - Lint (ESLint)
# - Type check (TypeScript)
# - Testes unitários (se houver)
# - Formatação (se configurado)

echo "🔍 Executando validações pré-commit..."

# 0. Verificar imports duplicados (antes de tudo)
echo "🔍 Verificando imports duplicados..."
if [ -f "scripts/validar-imports.sh" ]; then
  chmod +x scripts/validar-imports.sh 2>/dev/null || true
  # Verificar apenas arquivos staged (que serão commitados)
  git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx)$' | while read -r file; do
    if [ -f "$file" ]; then
      ./scripts/validar-imports.sh "$file" || {
        echo "❌ Imports duplicados encontrados em arquivos staged. Corrija antes de fazer commit."
        exit 1
      }
    fi
  done
else
  echo "⚠️  Script de verificação de imports não encontrado. Pulando..."
fi

# 1. Lint (apenas nos arquivos staged para não falhar em erros pré-existentes)
echo "📝 Executando ESLint nos arquivos staged..."
STAGED_TS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' | head -50)
if [ -n "$STAGED_TS" ]; then
  echo "$STAGED_TS" | xargs npx eslint --max-warnings 0 || {
    echo "❌ ESLint encontrou erros nos arquivos staged. Corrija antes de fazer commit."
    exit 1
  }
else
  echo "⚠️  Nenhum arquivo .ts/.tsx staged. Pulando lint."
fi

# 2. Type check
echo "🔷 Verificando tipos TypeScript..."
npx tsc --noEmit || {
  echo "❌ Erros de tipo encontrados. Corrija antes de fazer commit."
  exit 1
}

# 3. Build check (verifica se compila)
echo "🏗️  Verificando build..."
npm run build:dev || {
  echo "❌ Build falhou. Corrija antes de fazer commit."
  exit 1
}

echo "✅ Todas as validações passaram!"





